#!/usr/bin/env bash
set -euo pipefail

theme_only=false
if [[ "${1:-}" == "--theme-only" ]]; then
  theme_only=true
  shift
fi

if [[ $# -ne 1 ]]; then
  printf 'usage: apply-wallpaper [--theme-only] IMAGE\n' >&2
  exit 2
fi

wallpaper=$1
if [[ ! -f "$wallpaper" || ! -r "$wallpaper" ]]; then
  printf 'apply-wallpaper: not a readable image: %s\n' "$wallpaper" >&2
  exit 2
fi

case "${wallpaper,,}" in
  *.png|*.jpg|*.jpeg|*.webp|*.gif) ;;
  *) printf 'apply-wallpaper: unsupported image extension\n' >&2; exit 2 ;;
esac

# Canonicalize `.` and `..` without resolving a Home Manager wallpaper
# symlink into a garbage-collectable Nix store path in persistent state.
wallpaper=$(realpath --no-symlinks "$wallpaper")
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/aurora-theme"
matugen_config="${AURORA_MATUGEN_CONFIG:-$config_home/matugen/aurora.toml}"
lock_file="$cache_root/apply.lock"

if [[ ! -r "$matugen_config" ]]; then
  printf 'apply-wallpaper: Matugen config is missing: %s\n' "$matugen_config" >&2
  exit 1
fi

mkdir -p "$cache_root"
exec 9>"$lock_file"
flock 9

stage_root=$(mktemp -d "$cache_root/.stage.XXXXXX")
cleanup() {
  rm -rf "$stage_root"
}
trap cleanup EXIT

matugen image "$wallpaper" \
  --config "$matugen_config" \
  --prefix "$stage_root" \
  --type scheme-content \
  --mode dark \
  --contrast 0.08 \
  --source-color-index 0 \
  --quiet

outputs=(
  quickshell.json
  waybar.css
  kitty.conf
  rofi.rasi
  hyprland.lua
  hyprlock.conf
  gtk.css
  dunstrc
)

for output in "${outputs[@]}"; do
  if [[ ! -s "$stage_root/$output" ]]; then
    printf 'apply-wallpaper: Matugen did not create %s\n' "$output" >&2
    exit 1
  fi
done

if grep -R -F '{{' "$stage_root" >/dev/null; then
  printf 'apply-wallpaper: unresolved Matugen expression detected\n' >&2
  exit 1
fi

jq -e '
  type == "object"
  and ([
    .background, .panel, .panelRaised, .surface, .surfaceHover,
    .outline, .outlineStrong, .primary, .secondary, .tertiary,
    .success, .warning, .error, .text, .textMuted, .textDim, .onAccent
  ] | all(type == "string" and test("^#[0-9A-Fa-f]{6}$")))
' "$stage_root/quickshell.json" >/dev/null

# Hyprlock's palette and current background must change as one atomic theme.
# Hyprland-style config values consume the rest of the assignment as a path,
# including ordinary spaces in user wallpaper filenames.
printf '\n%s = %s\n' "\$auroraWallpaper" "$wallpaper" >> "$stage_root/hyprlock.conf"

for output in "${outputs[@]}"; do
  chmod 600 "$stage_root/$output"
  mv -f "$stage_root/$output" "$cache_root/$output"
done

state_file="$cache_root/wallpaper.json"
state_stage=$(mktemp "$cache_root/.wallpaper-state.XXXXXX")
jq -n \
  --arg path "$wallpaper" \
  --argjson updated_at "$(date +%s)" \
  '{path: $path, updated_at: $updated_at, scheme: "scheme-content", mode: "dark"}' \
  > "$state_stage"
chmod 600 "$state_stage"
mv -f "$state_stage" "$state_file"

if [[ "$theme_only" == true ]]; then
  printf '%s\n' "$wallpaper"
  exit 0
fi

if ! awww query >/dev/null 2>&1; then
  systemctl --user start aurora-wallpaper.service >/dev/null 2>&1 || true
  for _ in {1..20}; do
    awww query >/dev/null 2>&1 && break
    sleep 0.05
  done
fi

awww img "$wallpaper" \
  --resize crop \
  --filter Lanczos3 \
  --transition-type grow \
  --transition-pos 0.82,0.12 \
  --transition-duration 1.15 \
  --transition-fps 30 \
  --transition-bezier .16,1,.3,1

# QuickShell observes its JSON through FileView. Waybar's documented reload
# signal and a compositor config reload apply their generated fragments.
# Never signal Kitty: SIGUSR1 is not a configuration reload and terminates
# clients on this build. New Kitty processes read the new include safely.
systemctl --user try-restart swayosd.service >/dev/null 2>&1 || true
systemctl --user try-restart aurora-notification-fallback.service >/dev/null 2>&1 || true
pkill -SIGUSR2 waybar >/dev/null 2>&1 || true
hyprctl reload >/dev/null 2>&1 || true

printf '%s\n' "$wallpaper"
