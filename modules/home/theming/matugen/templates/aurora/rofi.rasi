/* Generated atomically by apply-wallpaper; import from the main launcher. */
* {
    aurora-background: #05060bf2;
    aurora-panel: #0b0e16ed;
    aurora-surface: #151b2ae6;
    aurora-surface-hover: #1c2538f2;
    aurora-outline: {{colors.outline.default.hex}}80;
    aurora-primary: {{colors.primary.default.hex}};
    aurora-secondary: {{colors.secondary.default.hex}};
    aurora-tertiary: {{colors.tertiary.default.hex}};
    aurora-text: {{colors.on_surface.default.hex}};
    aurora-text-muted: {{colors.on_surface_variant.default.hex}};
    aurora-error: {{colors.error.default.hex}};
}
