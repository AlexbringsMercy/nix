-- Aurora: load hyprbars from its ABI-matched Nix store output before configuring it.
hl.plugin.load("@HYPRBARS_PLUGIN@")

-- Button VISUALS are ours: clean modern monochrome controls on the dark bar (NOT
-- traffic-lights, NOT a Windows/macOS copy). Actions use Hyprland 0.55 NATIVE-LUA
-- dispatch forms — the legacy `hyprctl dispatch killactive`/`fullscreen 1` strings
-- the 0.55 Lua parser rejects at runtime (verified live 2026-07-21). Interim §3.1
-- literals; Stage 4 templates colours + hover states from the live scheme.
hl.config({
    plugin = {
        hyprbars = {
            bar_height = 30,
            bar_padding = 10,
            bar_button_padding = 10,
            bar_text_size = 12,
            bar_text_font = "FiraCode Nerd Font",
            bar_text_align = "left",
            bar_part_of_window = true,
            bar_precedence_over_border = true,
            on_double_click = "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"toggle\" })'", -- Aurora: 0.55 lua form (double-click maximize).
            bar_color = "rgb(0a0e1a)", -- Aurora: interim §3.1 glass; Stage 4 templates it.
            col = {
                text = "rgb(e6edf7)" -- Aurora: interim §3.1 onSurface; Stage 4 templates it.
            }
        }
    }
})

-- Monochrome glyph-only buttons (transparent bg = no coloured dot), size bumped
-- from 14 (too tiny). add_button is right-to-left: first add = rightmost, so
-- close, maximize, minimize -> on screen: minimize | maximize | close.
hl.plugin.hyprbars.add_button({
    bg_color = "rgba(00000000)",
    fg_color = "rgb(e6edf7)",
    size = 24, -- Aurora: was 20 — slightly larger controls for the operator-requested Stage 2A refinement.
    icon = "󰖭",
    action = "hyprctl dispatch 'hl.dsp.window.close()'" -- Aurora: 0.55 lua close (legacy killactive is rejected).
})
hl.plugin.hyprbars.add_button({
    bg_color = "rgba(00000000)",
    fg_color = "rgb(aab6c8)",
    size = 24,
    icon = "󰖯",
    action = "hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = \"maximized\", action = \"toggle\" })'" -- Aurora: 0.55 lua maximize toggle.
})
hl.plugin.hyprbars.add_button({
    bg_color = "rgba(00000000)",
    fg_color = "rgb(aab6c8)",
    size = 24,
    icon = "󰖰",
    action = "window-minimize" -- Aurora: the vendored omarchy script (its internals now use 0.55 lua dispatch).
})
