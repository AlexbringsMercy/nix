# Aurora: static emergency styling; independent of the retired wallpaper renderer.
[global]
    # Aurora: keep failure notifications readable without taking over the desktop.
    monitor = 0
    follow = mouse
    width = 360
    height = 300
    origin = top-right
    offset = 16x16
    notification_limit = 5
    font = Sans 10
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    padding = 12
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#1c2742"
    separator_color = frame
    corner_radius = 10
    background = "#0a0e1a"
    foreground = "#e6edf7"
    timeout = 8

# Aurora: urgent failures persist until acknowledged.
[urgency_critical]
    frame_color = "#38bdf8"
    timeout = 0
