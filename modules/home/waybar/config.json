{
  "name": "aurora-taskbar",
  "layer": "top",
  "position": "top",
  "output": ["eDP-1"],
  "height": 40,
  "spacing": 0,
  "margin-top": 6,
  "margin-left": 8,
  "margin-right": 8,
  "margin-bottom": 0,
  "fixed-center": false,
  "exclusive": true,
  "reload_style_on_change": true,

  "modules-left": [
    "custom/apps",
    "custom/chrome",
    "custom/terminal",
    "custom/files",
    "wlr/taskbar"
  ],
  "modules-center": [
    "hyprland/workspaces",
    "hyprland/window",
    "custom/window-float",
    "custom/window-maximize",
    "custom/window-fullscreen",
    "custom/window-close"
  ],
  "modules-right": [
    "cpu",
    "memory",
    "custom/music-panel",
    "custom/media-prev",
    "mpris",
    "custom/media-play",
    "custom/media-next",
    "pulseaudio",
    "network",
    "bluetooth",
    "battery",
    "clock",
    "custom/notifications",
    "tray"
  ],

  "custom/apps": {
    "format": "󰀻  Apps",
    "tooltip-format": "Applications\nClick or press Super to search",
    "on-click": "rofi-toggle"
  },
  "custom/chrome": {
    "format": "",
    "tooltip-format": "Google Chrome",
    "on-click": "google-chrome-stable --ozone-platform-hint=auto"
  },
  "custom/terminal": {
    "format": "",
    "tooltip-format": "Kitty terminal",
    "on-click": "kitty"
  },
  "custom/files": {
    "format": "",
    "tooltip-format": "Files",
    "on-click": "thunar"
  },

  "wlr/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "tooltip-format": "{title}",
    "all-outputs": false,
    "active-first": true,
    "on-click": "minimize-raise",
    "on-click-middle": "close"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "1": "1",
      "2": "2",
      "active": "",
      "urgent": "",
      "default": ""
    },
    "persistent-workspaces": {
      "eDP-1": [1, 2]
    },
    "persistent-only": true,
    "show-special": false,
    "all-outputs": false,
    "disable-scroll": true
  },
  "hyprland/window": {
    "format": "{title}",
    "separate-outputs": true,
    "max-length": 24,
    "rewrite": {
      "^(.*) — Mozilla Firefox$": "$1",
      "^(.*) - Google Chrome$": "$1",
      "^$": "Desktop"
    }
  },
  "custom/window-float": {
    "format": "󰉈",
    "tooltip-format": "Float / tile active window\nRight click: pin floating window",
    "on-click": "hyprctl dispatch togglefloating",
    "on-click-right": "hyprctl dispatch pin"
  },
  "custom/window-maximize": {
    "format": "󰊓",
    "tooltip-format": "Maximize / restore active window",
    "on-click": "hyprctl dispatch fullscreen 1"
  },
  "custom/window-fullscreen": {
    "format": "󰊔",
    "tooltip-format": "Full screen / restore active window",
    "on-click": "hyprctl dispatch fullscreen 0"
  },
  "custom/window-close": {
    "format": "󰅖",
    "tooltip-format": "Close active window",
    "on-click": "hyprctl dispatch killactive"
  },

  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "tooltip": true,
    "max-length": 8,
    "tooltip-format": "CPU usage: {usage}%\nLoad: {load}\nClick for System Monitor",
    "on-click": "missioncenter"
  },
  "memory": {
    "interval": 3,
    "format": " {percentage}%",
    "max-length": 8,
    "tooltip-format": "Memory: {used:0.1f} GiB / {total:0.1f} GiB\nClick for System Monitor",
    "on-click": "missioncenter"
  },

  "custom/media-prev": {
    "format": "󰒮",
    "tooltip-format": "Previous track",
    "on-click": "playerctl previous"
  },
  "custom/music-panel": {
    "format": "󰎆",
    "tooltip-format": "Music, visualizer, and equalizer",
    "on-click": "qs -c aurora-shell ipc call panels toggle music"
  },
  "mpris": {
    "format": "{status_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "status-icons": {
      "playing": "󰐊",
      "paused": "󰏤",
      "stopped": "󰓛"
    },
    "dynamic-order": ["title", "artist"],
    "dynamic-separator": " · ",
    "title-len": 14,
    "artist-len": 9,
    "dynamic-len": 22,
    "max-length": 24,
    "ellipsis": "…",
    "tooltip-format": "{title}\n{artist} — {album}",
    "on-click": "qs -c aurora-shell ipc call panels toggle music",
    "on-click-right": "playerctl play-pause"
  },
  "custom/media-play": {
    "format": "󰐎",
    "tooltip-format": "Play / pause",
    "on-click": "playerctl play-pause"
  },
  "custom/media-next": {
    "format": "󰒭",
    "tooltip-format": "Next track",
    "on-click": "playerctl next"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰖁 mute",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "portable": "󰄜",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "max-length": 10,
    "scroll-step": 3,
    "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 3%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 3%-",
    "on-click": "qs -c aurora-shell ipc call panels toggle volume",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pwvucontrol",
    "tooltip-format": "{desc}\nVolume {volume}%"
  },
  "network": {
    "interval": 3,
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-linked": "󰤭",
    "format-disconnected": "󰤮",
    "max-length": 10,
    "tooltip-format-wifi": "{essid}\nSignal {signalStrength}% · {frequency} GHz\n{ipaddr}",
    "tooltip-format-ethernet": "Wired · {ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "qs -c aurora-shell ipc call panels toggle wifi",
    "on-click-right": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "format-no-controller": "󰂲",
    "max-length": 6,
    "tooltip-format": "Bluetooth {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "on-click": "qs -c aurora-shell ipc call panels toggle bluetooth",
    "on-click-right": "blueman-manager"
  },
  "battery": {
    "interval": 15,
    "states": {
      "warning": 25,
      "critical": 12
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-full": "󰁹 100%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "max-length": 10,
    "tooltip-format": "Battery {capacity}%\n{timeTo}",
    "on-click": "qs -c aurora-shell ipc call panels toggle power",
    "on-click-right": "wlogout -p layer-shell"
  },
  "clock": {
    "interval": 1,
    "format": "󰥔 {:%H:%M  ·  %a %b %d}",
    "tooltip-format": "<big>{:%A, %B %d}</big>\n{calendar}",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "{}",
        "weeks": "W{}",
        "weekdays": "<b>{}</b>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "on-click": "qs -c aurora-shell ipc call panels toggle calendar"
  },
  "custom/notifications": {
    "format": "󰂚",
    "tooltip-format": "Notifications",
    "on-click": "qs -c aurora-shell ipc call panels toggle notifications",
    "on-click-right": "qs -c aurora-shell ipc call notifications toggleDnd"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  }
}
