+    // grab whose side lies on the work-area boundary then contributes no axis at all.
+    // CWindowTarget::updatePos already measures the identical flags against space()->workArea().
+    const auto MONITOR_WORKAREA = m_parent->space()->workArea();
     const auto BOX              = target->position();
     const bool DISPLAYLEFT      = STICKS(BOX.x, MONITOR_WORKAREA.x);
     const bool DISPLAYRIGHT     = STICKS(BOX.x + BOX.w, MONITOR_WORKAREA.x + MONITOR_WORKAREA.w);
